{
  "name": "jore-graphql",
  "version": "1.1.0",
  "main": "index.js",
  "author": "Hannes Junnila",
  "license": "MIT",
  "scripts": {
    "start": "node -r dotenv/config index.js",
    "start:production": "node index.js",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\""
  },
  "dependencies": {
    "postgraphile": "^4.14.1"
  },
  "devDependencies": {
    "dotenv": "^17.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.5",
    "prettier": "^3.6.2"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "prettier --write",
      "git add"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  }
}
